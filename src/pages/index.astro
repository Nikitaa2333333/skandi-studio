---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Gallery from '../components/Gallery.astro';
import Footer from '../components/Footer.astro';
import { asset } from '../lib/asset';

// Контент — рыба под тему «студия скандинавского дизайна и мебели».
// Композиция и все приёмы — из dr.chashchina, менять тексты, не сетку.

const steps = [
  {
    title: 'Разобраться',
    text: 'Сначала нужно понять, как вы живёте. Кто готовит и как часто, где копятся вещи, куда падает свет по утрам. От этого напрямую зависит, какая мебель нужна, а какая будет просто занимать место. Иногда достаточно разговора, иногда мы приезжаем на обмер.',
  },
  {
    title: 'Собрать основу',
    text: 'Планировка, крупная мебель, сценарии света. Основа делает квартиру удобной ещё до того, как в ней появится хоть одна декоративная вещь.',
  },
  {
    title: 'Наполнить деталями',
    text: 'И только когда основа собрана, есть смысл переходить к текстилю, керамике и декору. В обратном порядке получается склад красивых вещей, а не дом.',
  },
];

const values = [
  { t: 'Честные материалы', d: 'Массив дерева, шерсть, лён, камень. То, что стареет красиво, а не выходит из строя.' },
  { t: 'Предсказуемый бюджет', d: 'Смета фиксируется до старта, а не растёт по ходу. Вы знаете, что и сколько стоит, до первой покупки.' },
  { t: 'Ваше участие', d: 'Дом собирается под ваш быт, а не под картинку из каталога. Это не дополнение к проекту, это его условие.' },
];

const catalog = [
  {
    t: 'Мебель из массива',
    d: 'Столы, стулья, кровати и фасады из дуба и ясеня. Простые формы, которые не надоедают и переживают переезды.',
  },
  {
    t: 'Системы хранения',
    d: 'Шкафы и стеллажи под ваши вещи, а не «вообще». Хаос исчезает, когда у каждой вещи есть своё место.',
  },
  {
    t: 'Свет',
    d: 'Тёплые сценарии вместо одной люстры: рабочий, вечерний, ночной. Свет делает уют больше, чем любая покупка.',
  },
  {
    t: 'Текстиль и декор',
    d: 'Шерсть, лён и керамика ручной работы. Последний слой, который превращает собранную квартиру в живой дом.',
  },
];

const services = [
  {
    t: 'Подбор из коллекций',
    d: 'Соберём комплект из готовых позиций шоурума под вашу планировку и бюджет. Быстро и без ремонта.',
  },
  {
    t: 'Мебель по вашим размерам',
    d: 'Когда типовое не встаёт: ниши, эркеры, нестандартная высота. Делаем на своём производстве, сроки называем честно.',
  },
  {
    t: 'Комплектация под ключ',
    d: 'От планировки до расстановки: мебель, свет, текстиль. Вы въезжаете в готовый дом, а не в список коробок.',
  },
  {
    t: 'Доставка и сборка',
    d: 'Привозим, собираем, увозим упаковку. Дом остаётся домом, а не стройплощадкой.',
  },
];

const zones = ['Прихожая', 'Кухня-гостиная', 'Спальня'];

const homecare = [
  'Уход за деревом: масло вместо лака',
  'Текстиль: как стирать шерсть и лён',
  'Что докупать сезонно, а что — никогда',
];

const press = [
  { src: 'AD', t: 'Сканди без клише: как не превратить дом в шоурум' },
  { src: 'Elle Decoration', t: 'Пять ошибок при покупке мебели из массива' },
  { src: 'INMYROOM', t: 'Свет в маленькой квартире: три сценария' },
  { src: 'The Blueprint', t: 'Почему лагом пережил все тренды' },
  { src: 'Дом.РФ Журнал', t: 'Хранение без хаоса: с чего начать' },
  { src: 'Афиша Daily', t: 'Гид по скандинавским брендам в России' },
];

const rubrics = [
  'Материалы и износ',
  'Свет в квартире',
  'Хранение без хаоса',
  'Сканди-классика и подделки',
  'Уход за мебелью',
  'Маленькие квартиры',
];

const symptoms = [
  'Ремонт закончился, а квартира так и не стала домом.',
  'Мебель покупалась по случаю, и теперь ничего ни с чем не дружит.',
  'Вещи копятся, а хранить их негде — хотя шкафов вроде хватает.',
  'Вечером дома неуютно: свет либо больничный, либо его нет.',
  'Хочется скандинавский интерьер, но страшно получить каталог IKEA.',
  'Нравятся картинки в Pinterest, но непонятно, как это перенести в свою планировку.',
];

const path = [
  { y: '2012', t: 'Первые поездки на фабрики Дании и Швеции, начало прямых поставок' },
  { y: '2014', t: 'Открытие шоурума в Москве' },
  { y: '2016', t: 'Собственное производство мебели из массива в Подмосковье' },
  { y: '2019', t: 'Первая собственная коллекция — стол и стулья Norr' },
  { y: '2021', t: 'Комплектация квартир под ключ как отдельное направление' },
  { y: '2023', t: 'Вторая площадка производства, доставка по всей России' },
  { y: 'Сегодня', t: 'Шоурум, производство и студия комплектации под одной крышей' },
];
---

<Layout
  title="Skandi Studio — скандинавская мебель и интерьеры"
  description="Мебель из массива, свет и текстиль. Собираем дом под ваш быт: от подбора из коллекций до комплектации под ключ."
>
  <Header />

  <!-- ============ 1. Первый экран ============
       Слева текст (прижат к низу кадра), справа видео-футаж; снизу
       видео — белый градиент, чтобы не было жёсткой границы с галереей. -->
  <section class="section section--flush-top section--flush-bottom hero">
    <div class="container hero__grid">
      <div class="hero__text">
        <p class="tag reveal">Скандинавская мебель и интерьеры · шоурум в Москве</p>
        <h1 class="display" data-split>Skandi Studio</h1>
        <p class="hero__role reveal" style="--reveal-delay:.12s">
          Мебель из массива, свет и текстиль. 12 лет практики.
        </p>
        <p class="lead reveal" style="--reveal-delay:.18s">
          Красивая картинка сама по себе не решает ничего. Решает то,
          насколько точно дом собран под ваш быт — привычки, хранение,
          свет и утро понедельника.
        </p>
        <div class="hero__cta reveal" style="--reveal-delay:.24s">
          <a href="#booking" class="btn">Обсудить проект</a>
          <p class="small hero__note">Первая консультация — бесплатно</p>
        </div>
      </div>

      <figure class="hero__photo">
        <video
          src={asset('video/ripple.mp4')}
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-hidden="true"
        ></video>
      </figure>
    </div>
  </section>

  <!-- ============ Галерея (приём из prmpt: скейл карточек от скролла) ============ -->
  <Gallery />

  <!-- ============ 2. С чем приходят ============ -->
  <section class="section" id="work">
    <div class="container">
      <p class="tag reveal">С чем приходят</p>
      <h2 data-split>Возможно, вам это знакомо</h2>
      <ul class="cards reveal-group">
        {symptoms.map((text, i) => (
          <li class="cards__item">
            <span class="tag cards__num">{String(i + 1).padStart(2, '0')}</span>
            <p>{text}</p>
          </li>
        ))}
      </ul>
      <p class="reveal">
        Если узнали себя <mark>хотя бы в одном пункте</mark> — дальше о том,
        как мы с этим работаем.
      </p>
    </div>
  </section>

  <!-- ============ 3. Работа с двух сторон ============
       Общий заголовок + контрастный сплит: светлая и шалфейная половины -->
  <section id="halves">
    <div class="container halves-head">
      <p class="tag reveal">Из чего складывается дом</p>
      <h2 data-split>Работа идёт с&nbsp;двух сторон</h2>
      <p class="lead reveal">
        Мебель — только половина дела. Вторая половина — то, как
        устроен ваш быт: от&nbsp;него зависит, станет&nbsp;ли красивая
        квартира удобным домом.
      </p>
    </div>
    <div class="halves-split">
      <div class="halves-split__col halves-split__col--light">
        <div class="halves-split__inner">
          <p class="tag reveal">01</p>
          <h3 class="halves-split__title" data-split>Форма</h3>
          <p class="reveal">
            Дерево, свет, текстиль, пропорции. Всё, что видно глазу
            и приятно руке — с честными материалами и простыми линиями,
            которые не надоедают через сезон.
          </p>
        </div>
      </div>
      <div class="halves-split__col halves-split__col--sage">
        <video
          class="halves-split__video"
          src={asset('video/serum.mp4')}
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-hidden="true"
        ></video>
        <div class="halves-split__inner">
          <p class="tag reveal">02</p>
          <h3 class="halves-split__title" data-split>Функция</h3>
          <p class="reveal">
            Хранение, сценарии света, маршруты по квартире, уборка.
            Всё, из-за чего интерьер живёт или раздражает — и что
            не исправить ни одной красивой вещью.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Тёмная контрастная секция (реф: hero croptab на глубоком олива) -->
  <section class="section theme-dark">
    <div class="container">
      <p class="tag reveal">Два слова, на которых стоит сканди</p>
      <div class="mechanisms reveal-group">
        <div class="mechanisms__item">
          <h3>Лагом</h3>
          <p>
            «Ровно столько, сколько нужно». Не минимализм ради пустоты,
            а точная мера: вещей достаточно, лишнего нет, каждая работает.
          </p>
        </div>
        <div class="mechanisms__item">
          <h3>Хюгге</h3>
          <p>
            Уют как ежедневная практика, а не событие. Тёплый свет, честные
            материалы и место, где вечером хочется остаться дома.
          </p>
        </div>
      </div>
      <hr class="rule mechanisms__rule" />
      <p class="lead reveal">
        Дом — самая большая вещь, которой вы пользуетесь каждый день.
        Собирая его, мы работаем не с отдельным стулом, а с тем, как
        устроена ваша жизнь целиком.
      </p>
    </div>
  </section>

  <!-- ============ 4. Как строится работа ============ -->
  <section class="section" id="steps">
    <div class="container">
      <p class="tag reveal">Как строится работа</p>
      <h2 data-split>Почему мы не начинаем с декора</h2>
      <div class="spec reveal-group">
        {steps.map((s, i) => (
          <div class="spec__row">
            <span class="tag">0{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        ))}
      </div>
      <p class="tag spec__sub reveal">Что для нас важно</p>
      <div class="triple reveal-group">
        {values.map((v) => (
          <div>
            <h3>{v.t}</h3>
            <p>{v.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Фото-пауза: во всю ширину экрана -->
  <figure class="strip">
    <img src={asset('photos/web/strip1.webp')} alt="Интерьер Skandi Studio" loading="lazy" decoding="async" />
    <figcaption class="strip__cap">
      <span>
        Мебель работает, когда понятен быт. Семьи живут по-разному,
        и то, что собрало дом друзьям, вам может просто не подойти.
      </span>
      <span>
        Поэтому проект начинается с разговора о том, как вы живёте,
        а не с каталога. Иногда — с обмера: часть решений видна только
        на месте.
      </span>
    </figcaption>
  </figure>

  <!-- ============ 5. Каталог ============ -->
  <section class="section section--surface" id="methods">
    <div class="container">
      <p class="tag reveal">Каталог</p>
      <h2 data-split>Из чего собирается дом</h2>
      <p class="lead reveal">
        Ниже — не список товаров, а объяснение того, что каждое
        направление даёт дому. Конкретные позиции имеет смысл обсуждать
        уже на встрече, когда понятна задача.
      </p>
      <div class="passport passport--bento reveal-group">
        {catalog.map((h, i) => (
          i === 3 ? (
            <div class="passport__card passport__card--feature">
              <div class="passport__feature-text">
                <span class="tag">0{i + 1}</span>
                <div class="passport__body">
                  <h3>{h.t}</h3>
                  <p class="passport__desc">{h.d}</p>
                </div>
              </div>
              <video
                class="passport__video"
                src={asset('video/ripple.mp4')}
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                aria-hidden="true"
              ></video>
            </div>
          ) : (
            <div class="passport__card">
              <span class="tag">0{i + 1}</span>
              <div class="passport__body">
                <h3>{h.t}</h3>
                <p class="passport__desc">{h.d}</p>
              </div>
            </div>
          )
        ))}
      </div>
      <div class="quit reveal">
        <h3>Чего мы не делаем</h3>
        <p>
          Мода на интерьеры меняется быстро, и часть решений, популярных
          пять лет назад, сегодня выглядит устаревшей или просто неудобна
          в быту. Мы о них говорим честно — в том числе о тех, что нам
          самим когда-то нравились.
        </p>
      </div>
    </div>
  </section>

  <!-- ============ 6. Планировка ============ -->
  <section class="section" id="planning">
    <div class="container split">
      <div>
        <p class="tag reveal">Планировка</p>
        <h2 data-split>С чего начинается дом</h2>
        <p class="reveal">
          Неуютной квартиру делает не мебель, а то, как она расставлена —
          маршруты, свет, мёртвые углы. Поэтому новые покупки почти
          не спасают: они работают выше, а проблема глубже.
        </p>
      </div>
      <figure class="split__photo reveal">
        <img src={asset('photos/web/09.webp')} alt="Планировка и расстановка" loading="lazy" decoding="async" />
      </figure>
    </div>
  </section>

  <!-- ============ 7. Услуги ============ -->
  <section class="section section--surface" id="services">
    <div class="container">
      <p class="tag reveal">Услуги</p>
      <h2 data-split>Как можно с нами работать</h2>
      <p class="lead reveal">
        Говорим не о товарах, а о задачах. Состав работы подбирается
        под задачу, а не наоборот.
      </p>
      <div class="passport reveal-group">
        {services.map((t, i) => (
          <div class="passport__card">
            <span class="tag">0{i + 1}</span>
            <div class="passport__body">
              <h3>{t.t}</h3>
              <p class="passport__desc">{t.d}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 8. Зоны, которые решают ============ -->
  <section class="section" id="zones">
    <div class="container">
      <p class="tag reveal">Зоны, которые решают</p>
      <h2 data-split>Дом встречает прихожей</h2>
      <p class="lead reveal">
        Ощущение дома складывается не в гостиной с дивана. Первыми его
        создают прихожая, кухня и спальня — и именно им обычно достаётся
        меньше всего внимания.
      </p>
      <ul class="zones reveal-group">
        {zones.map((z) => (
          <li>
            <h3>{z}</h3>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ 9. Манифест ============ -->
  <section class="section theme-dark" id="inside">
    <div class="container">
      <p class="tag reveal">Про главное</p>
      <p class="manifesto reveal">
        Уют начинается <mark>не с покупки</mark>
      </p>
      <div class="manifesto__cols reveal-group">
        <p>
          Дом во многом определяется тем, как устроен быт. Хранение,
          сценарии света, маршруты по квартире, привычки семьи — всё это
          отражается на ощущении от интерьера раньше, чем мы связываем
          одно с другим.
        </p>
        <p>
          Мы не верим в одну вещь, которая решит все проблемы. Живой
          дом — это всегда результат комплексной работы: планировки,
          света, честных материалов и внимания к тому, как вы живёте
          на самом деле.
        </p>
      </div>
      <a class="link-arrow reveal" href="#articles">Читать статьи →</a>
    </div>
  </section>

  <!-- ============ 10. Уход за домом ============ -->
  <section class="section" id="homecare">
    <div class="container split split--reverse">
      <figure class="split__photo reveal">
        <img src={asset('photos/web/07.webp')} alt="Уход за мебелью" loading="lazy" decoding="async" />
      </figure>
      <div>
        <p class="tag reveal">Уход за домом</p>
        <h2 data-split>Чтобы служило десятилетиями</h2>
        <p class="reveal">
          Мебель из массива живёт дольше владельца, если за ней правильно
          ухаживать. Но вокруг ухода столько маркетинга, что разобраться
          самостоятельно почти невозможно.
        </p>
        <ul class="list-plain reveal-group">
          {homecare.map((h) => (
            <li>
              <h3>{h}</h3>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ 11. Соцсети и СМИ ============ -->
  <section class="section section--surface" id="press">
    <div class="container">
      <p class="tag reveal">Публикации в СМИ</p>
      <h2 data-split>Нас спрашивают</h2>
      <p class="lead reveal">
        За годы работы нас приглашали комментировать AD, Elle Decoration,
        INMYROOM, The Blueprint и другие издания. Здесь собрано главное.
      </p>
      <div class="pressrows reveal-group">
        {press.map((p) => (
          <div class="pressrows__row">
            <span class="tag">{p.src}</span>
            <h3>{p.t}</h3>
            <span class="pressrows__arrow" aria-hidden="true">→</span>
          </div>
        ))}
      </div>
      <div class="socials reveal">
        <p>
          Если пока не готовы к проекту — подписывайтесь. Разбираем то,
          о чём чаще всего спрашивают в шоуруме: материалы, свет, хранение
          и мифы вокруг сканди.
        </p>
        <nav class="socials__links">
          <a href="#">Telegram</a>
          <a href="#">ВКонтакте</a>
        </nav>
      </div>
    </div>
  </section>

  <!-- ============ 12. О студии ============ -->
  <section class="section" id="about">
    <div class="container">
      <p class="tag reveal">О студии</p>
      <h2 data-split>Ради чего всё это</h2>
      <p class="lead reveal">
        Квартиру можно обставить и за неделю — вопрос в том, каким этот
        дом будет через десять лет и захочется ли в него возвращаться.
        <mark>Ради этого всё и делается.</mark>
      </p>
      <div class="path reveal">
        <div class="path__head">
          <h3>Наш путь</h3>
          <span class="tag" aria-hidden="true">листайте вбок →</span>
        </div>
        <div class="path__scroller">
          <ol class="path__track" tabindex="0" aria-label="Наш путь — ключевые этапы по годам">
            {path.map((p) => (
              <li class="path__item">
                <span class="path__year">{p.y}</span>
                <p class="path__text">{p.t}</p>
              </li>
            ))}
