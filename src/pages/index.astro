---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Gallery from '../components/Gallery.astro';
import Footer from '../components/Footer.astro';
import { asset } from '../lib/asset';

// ВИТРИНА ЭЛЕМЕНТОВ, не сайт. Каждый блок показан один раз с рыбой
// вместо контента, чтобы было видно поведение, а не смысл.
// Структуру страницы собираешь сам: копируешь нужный блок отсюда,
// стили уже глобальные (src/styles/blocks.css).

const lorem =
  'Наборный абзац — мера строки задана токеном на самом элементе, ' +
  'поэтому строка не уезжает за комфортные 68–78 знаков даже на широком экране.';
const short = 'Короткое описание карточки на пару строк.';
---

<Layout title="Дизайн-кит — витрина элементов" description="Набор блоков и токенов дизайн-системы.">
  <Header />

  <!-- HERO: текст + медиа, градиент вниз. Для портрета-вырезки
       добавить .hero__photo--cutout, для видео — оставить как есть. -->
  <section class="section section--flush-top section--flush-bottom">
    <div class="container hero__grid">
      <div class="hero__text">
        <p class="tag reveal">Бирка · мелкий технический лейбл</p>
        <h1 class="display" data-split>Заголовок</h1>
        <p class="hero__role reveal" style="--reveal-delay:.12s">
          Подзаголовок под именем — заголовочный уровень, не микролейбл.
        </p>
        <p class="lead reveal" style="--reveal-delay:.18s">
          Лид первого экрана: 56–64 знака в строке, вес 380, чуть крупнее набора.
        </p>
        <div class="hero__cta reveal" style="--reveal-delay:.24s">
          <a href="#form" class="btn">Кнопка</a>
          <p class="small hero__note">Подпись под кнопкой</p>
        </div>
      </div>
      <figure class="hero__photo">
        <video src={asset('video/ripple.mp4')} autoplay muted loop playsinline preload="metadata" aria-hidden="true"></video>
      </figure>
    </div>
  </section>

  <!-- ГАЛЕРЕЯ: рассыпанная сетка, карточки растут от позиции скролла -->
  <Gallery />

  <!-- ТИПОГРАФИКА И ЦВЕТ -->
  <section class="section">
    <div class="container">
      <p class="tag reveal">Витрина</p>
      <h2 data-split>Типографика</h2>
      <div class="spec reveal-group">
        <div class="spec__row"><span class="tag">01</span><h3>display</h3><p>Первый экран, вес 300, межстрочный 0.9</p></div>
        <div class="spec__row"><span class="tag">02</span><h3>h1 / h2 / h3</h3><p>Заголовки: вес 330, отрицательный трекинг, капс запрещён</p></div>
        <div class="spec__row"><span class="tag">03</span><h3>lead</h3><p>Лид: крупнее набора, вес 380, мера 60ch</p></div>
        <div class="spec__row"><span class="tag">04</span><h3>body / small / tag</h3><p>Набор, техподпись, микролейбл — жирность и курсив внутри запрещены</p></div>
      </div>

      <p class="tag spec__sub reveal">Цвет</p>
      <div class="triple reveal-group">
        <div><h3>Зелёный авокадо</h3><p>Акцент: ссылки, бирки, номера, детали. Токен --c-green.</p></div>
        <div><h3>Глубокий лесной</h3><p>Тёмные контрастные секции. Токен --c-green-deep, класс .theme-dark.</p></div>
        <div><h3>Шалфей</h3><p>Маркер, выделение, подложка широкой карточки. Токен --c-green-pale.</p></div>
      </div>
      <p class="reveal">Выделение фразы — только <mark>фирменным маркером</mark>, не жирностью.</p>
    </div>
  </section>

  <!-- КАРТОЧКИ С НОМЕРАМИ -->
  <section class="section section--surface">
    <div class="container">
      <p class="tag reveal">.cards</p>
      <h2 data-split>Карточки с номерами</h2>
      <ul class="cards reveal-group">
        {[1, 2, 3, 4, 5, 6].map((n) => (
          <li class="cards__item">
            <span class="tag cards__num">{String(n).padStart(2, '0')}</span>
            <p>Текст карточки читается крупно, как лид — это смысловой центр секции.</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- КОНТРАСТНЫЙ СПЛИТ: половина светлая, половина с видео под вуалью -->
  <section>
    <div class="container halves-head">
      <p class="tag reveal">.halves-split</p>
      <h2 data-split>Контрастный сплит</h2>
      <p class="lead reveal">Две половины во всю ширину экрана: одна на сером, вторая с футажом под шалфейной вуалью.</p>
    </div>
    <div class="halves-split">
      <div class="halves-split__col halves-split__col--light">
        <div class="halves-split__inner">
          <p class="tag reveal">01</p>
          <h3 class="halves-split__title" data-split>Половина</h3>
          <p class="reveal">{lorem}</p>
        </div>
      </div>
      <div class="halves-split__col halves-split__col--sage">
        <video class="halves-split__video" src={asset('video/serum.mp4')} autoplay muted loop playsinline preload="metadata" aria-hidden="true"></video>
        <div class="halves-split__inner">
          <p class="tag reveal">02</p>
          <h3 class="halves-split__title" data-split>Вторая</h3>
          <p class="reveal">{lorem}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ТЁМНАЯ СЕКЦИЯ: две колонки + линия + лид -->
  <section class="section theme-dark">
    <div class="container">
      <p class="tag reveal">.theme-dark + .mechanisms</p>
      <div class="mechanisms reveal-group">
        <div class="mechanisms__item"><h3>Колонка</h3><p>{lorem}</p></div>
        <div class="mechanisms__item"><h3>Колонка</h3><p>{lorem}</p></div>
      </div>
      <hr class="rule mechanisms__rule" />
      <p class="lead reveal">Лид на тёмном: текст чисто белый, приглушение запрещено.</p>
    </div>
  </section>

  <!-- ФОТО-ПАУЗА -->
  <figure class="strip">
    <img src={asset('photos/web/strip1.webp')} alt="" loading="lazy" decoding="async" />
    <figcaption class="strip__cap">
      <span>Фраза слева на градиенте — кадр во всю ширину, без кропа.</span>
      <span>Фраза справа. Мера каждой — 30 знаков.</span>
    </figcaption>
  </figure>

  <!-- КАРТОЧКИ-ПАСПОРТА + БЕНТО -->
  <section class="section section--surface">
    <div class="container">
      <p class="tag reveal">.passport--bento</p>
      <h2 data-split>Бенто с широкой карточкой</h2>
      <div class="passport passport--bento reveal-group">
        {[1, 2, 3].map((n) => (
          <div class="passport__card">
            <span class="tag">0{n}</span>
            <div class="passport__body"><h3>Заголовок</h3><p class="passport__desc">{short}</p></div>
          </div>
        ))}
        <div class="passport__card passport__card--feature">
          <div class="passport__feature-text">
            <span class="tag">04</span>
            <div class="passport__body"><h3>Широкая карточка</h3><p class="passport__desc">{short}</p></div>
          </div>
          <video class="passport__video" src={asset('video/ripple.mp4')} autoplay muted loop playsinline preload="metadata" aria-hidden="true"></video>
        </div>
      </div>
      <div class="quit reveal"><h3>Замыкающий блок</h3><p>{lorem}</p></div>
    </div>
  </section>

  <!-- РОВНАЯ СЕТКА ПАСПОРТОВ 4×N -->
  <section class="section">
    <div class="container">
      <p class="tag reveal">.passport</p>
      <h2 data-split>Ровная сетка карточек</h2>
      <div class="passport reveal-group">
        {[1, 2, 3, 4].map((n) => (
          <div class="passport__card">
            <span class="tag">0{n}</span>
            <div class="passport__body"><h3>Заголовок</h3><p class="passport__desc">{short}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- СПЛИТ ТЕКСТ + ФОТО (есть --reverse) -->
  <section class="section section--surface">
    <div class="container split">
      <div>
        <p class="tag reveal">.split</p>
        <h2 data-split>Текст и фото</h2>
        <p class="reveal">{lorem}</p>
        <ul class="list-plain reveal-group">
          <li><h3>Пункт перечисления</h3></li>
          <li><h3>Без буллитов и линий</h3></li>
          <li><h3>Ритм держат отступы</h3></li>
        </ul>
      </div>
      <figure class="split__photo reveal">
        <img src={asset('photos/web/09.webp')} alt="" loading="lazy" decoding="async" />
      </figure>
    </div>
  </section>

  <!-- МАНИФЕСТ НА ТЁМНОМ -->
  <section class="section theme-dark">
    <div class="container">
      <p class="tag reveal">.manifesto</p>
      <p class="manifesto reveal">Крупная фраза <mark>с маркером</mark></p>
      <div class="manifesto__cols reveal-group">
        <p>{lorem}</p>
        <p>{lorem}</p>
      </div>
      <a class="link-arrow reveal" href="#form">Ссылка-стрелка →</a>
    </div>
  </section>

  <!-- EDITORIAL-СТРОКИ + ТЕКСТ СО ССЫЛКАМИ -->
  <section class="section">
    <div class="container">
      <p class="tag reveal">.pressrows</p>
      <h2 data-split>Строки списка</h2>
      <div class="pressrows reveal-group">
        {['Источник', 'Источник', 'Источник', 'Источник'].map((s) => (
          <div class="pressrows__row">
            <span class="tag">{s}</span>
            <h3>Заголовок строки — при наведении уезжает вправо</h3>
            <span class="pressrows__arrow" aria-hidden="true">→</span>
          </div>
        ))}
      </div>
      <div class="socials reveal">
        <p>{lorem}</p>
        <nav class="socials__links"><a href="#">Ссылка</a><a href="#">Ссылка</a></nav>
      </div>
    </div>
  </section>

  <!-- ТАЙМЛАЙН + СЕТКА «НОМЕР + ЗАГОЛОВОК» -->
  <section class="section section--surface">
    <div class="container">
      <p class="tag reveal">.path / .rubrics</p>
      <h2 data-split>Таймлайн и рубрики</h2>
      <div class="path reveal">
        <div class="path__head">
          <h3>Лента</h3>
          <span class="tag" aria-hidden="true">листайте вбок →</span>
        </div>
        <div class="path__scroller">
          <ol class="path__track" tabindex="0" aria-label="Лента этапов">
            {['2014', '2016', '2018', '2020', '2022', '2024', 'Сегодня'].map((y) => (
              <li class="path__item">
                <span class="path__year">{y}</span>
                <p class="path__text">Короткий текст этапа в одну-две строки.</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
      <ul class="rubrics reveal-group">
        {[1, 2, 3, 4, 5, 6].map((n) => (
          <li><span class="tag">0{n}</span><h3>Рубрика</h3></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ФОРМА НА ТЁМНОМ -->
  <section class="section theme-dark" id="form">
    <div class="container split">
      <div>
        <p class="tag reveal">.form</p>
        <h2 data-split>Форма</h2>
        <p class="reveal">Инпуты только с нижней границей, фокус — зелёный. Бэкенда нет, ведёт на /thanks.</p>
      </div>
      <form class="form reveal" action={asset('thanks')} method="get">
        <label><span class="tag">Имя</span><input type="text" name="name" required autocomplete="name" /></label>
        <label><span class="tag">Телефон</span><input type="tel" name="phone" required autocomplete="tel" /></label>
        <label class="form__check">
          <input type="checkbox" required />
          <span class="small">Согласен(на) на обработку персональных данных</span>
        </label>
        <button class="btn" type="submit">Отправить</button>
      </form>
    </div>
  </section>

  <Footer />
</Layout>