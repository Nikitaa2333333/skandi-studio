---
// Футер: тёмная полоса-примечание (реф: .drop-note) + служебная строка
import { asset } from '../lib/asset';
---

<footer class="footer">
  <div class="footer__note theme-dark">
    <div class="container footer__note-row">
      <p>Шоурум работает по записи. Доставка и сборка по всей России.</p>
    </div>
  </div>
  <div class="container footer__row">
    <p class="small">Skandi Studio, {new Date().getFullYear()}</p>
    <nav class="footer__links small">
      <a href="#">Telegram</a>
      <a href="#">ВКонтакте</a>
    </nav>
    <a class="small footer__policy" href={asset('policy')}>Политика обработки персональных данных</a>
  </div>
</footer>

<style>
  .footer__note {
    padding-block: 22px;
  }
  .footer__note p { max-width: none; }
  .footer__row {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 32px;
    justify-content: space-between;
    align-items: center;
    padding-block: 22px;
  }
  .footer__links {
    display: flex;
    gap: 24px;
  }
  .footer__policy { color: var(--c-green); }
  @media (max-width: 700px) {
    .footer__row { flex-direction: column; align-items: flex-start; }
  }
</style>